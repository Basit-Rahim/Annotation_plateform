# ---------------------------------------------------------------------------
# Urdu Reading Annotation Platform — environment variables
# Copy this file to .env and fill in the values marked CHANGE_ME.
# Commit .env.example; NEVER commit .env.
# ---------------------------------------------------------------------------

# --- Postgres (auto-provisioned by docker compose) -------------------------
POSTGRES_USER=urdu_annot
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=urdu_annot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Composed URL the app reads. Keep in sync with the four values above.
DATABASE_URL=postgresql://urdu_annot:CHANGE_ME_strong_db_password@postgres:5432/urdu_annot

# --- App server ------------------------------------------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
# docker-compose.prod.yml forces "production" (secure, HTTPS-only cookies).
ENVIRONMENT=development
# Generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32

# --- Hardcoded admin (MVP only; replace with user management in Phase 2) --
ADMIN_EMAIL=admin@dare-rc.lums.edu.pk
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# --- Audio storage (host paths; mounted into containers) ------------------
# Drop raw audio files here for manual ingestion (MVP substitute for Kobo).
AUDIO_DROP_DIR=./data/incoming
# Where accepted recordings are stored after ingest.
AUDIO_STORAGE_DIR=./data/audio

# --- Session and leases ---------------------------------------------------
SESSION_LIFETIME_MINUTES=1440
LEASE_DURATION_MINUTES=120

# --- Frontend --------------------------------------------------------------
# Development only. The production build calls /api on its own origin.
VITE_API_BASE_URL=http://localhost:8000

# --- Production (docker-compose.prod.yml) ----------------------------------
# Public hostname. Its DNS A record must point at the server and ports 80/443
# must be open; Caddy then fetches the HTTPS certificate automatically.
DOMAIN=annotate.example.org
# Days of nightly database + audio backups kept in ./backups.
BACKUP_KEEP_DAYS=14

# ---------------------------------------------------------------------------
# Deferred (Phase 2) — Kobo integration. Leave blank for MVP.
# ---------------------------------------------------------------------------
# KOBO_BASE_URL=https://kf.kobotoolbox.org
# KOBO_API_TOKEN=
# KOBO_ASSET_UID=
